{
	"name": "frosto-site-11ty",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "node scripts/build.mjs",
		"build:parity": "node scripts/build.mjs --dummy-endpoints",
		"check": "node scripts/parity-check.mjs",
		"parity": "npm run build:parity && npm run check",
		"test": "node --test scripts/*.test.mjs",
		"baseline": "node scripts/build-baseline.mjs",
		"baseline:verify": "node scripts/build-baseline.mjs --verify"
	},
	"devDependencies": {
		"@11ty/eleventy": "3.1.8",
		"parse5": "8.1.1",
		"purgecss": "8.0.0",
		"vite": "8.3.5"
	},
	"dependencies": {
		"bootstrap": "5.3.8"
	}
}
