---
title: Votre avis - Alerte gelées
description: Faites-nous savoir si une alerte vous a été utile ou si elle était inutile ou incorrecte.
noindex: true
homeLabel: Accueil du site
script: feedback
---
{% extends "layouts/base.njk" %}

{% block main %}
	<main class="container py-5">
		<section id="feedback-form-section" class="col-lg-7 mx-auto">
			<h1 class="fw-light mb-3">Votre avis sur une alerte</h1>
			<form id="feedback-form" action="%VITE_FEEDBACK_URL%" class="border rounded-3 bg-light p-4 p-md-5"
				method="post" enctype="application/x-www-form-urlencoded">
				<fieldset class="mb-4">
					<legend class="form-label">Cette alerte vous a-t-elle été utile&nbsp;?</legend>
					<div class="d-grid gap-2 d-sm-flex">
						<input class="btn-check" type="radio" name="sentiment" id="sentiment-positive" value="positive" required>
						<label class="btn btn-outline-success flex-fill" for="sentiment-positive">👍 Oui</label>
						<input class="btn-check" type="radio" name="sentiment" id="sentiment-negative" value="negative" required>
						<label class="btn btn-outline-danger flex-fill" for="sentiment-negative">👎 Non</label>
					</div>
				</fieldset>
				<div class="form-floating mb-3">
					<textarea class="form-control" id="text" name="text" maxlength="500" style="height: 120px" placeholder="Votre commentaire"></textarea>
					<label for="text">Commentaire (facultatif)</label>
				</div>
				<div class="form-floating mb-3">
					<input type="email" class="form-control" id="email" name="email" maxlength="254" autocomplete="email" placeholder="nom.prenom@exemple.com">
					<label for="email">Adresse e-mail (facultatif)</label>
				</div>
				<div id="feedback-consent" class="form-check mb-3" hidden>
					<input class="form-check-input" type="checkbox" id="consent" name="consent" value="true">
					<label class="form-check-label" for="consent">J'accepte que cette adresse soit utilisée pour me répondre ou me contacter au sujet de cet avis.</label>
				</div>
				<div class="form-aside" inert aria-hidden="true">
					<input type="text" name="comment" tabindex="-1" autocomplete="off">
				</div>
				<input type="hidden" name="lang" value="fr">
				<input type="hidden" name="source" value="home">
				<input type="hidden" name="locationPartitionKey" value="">
				<input type="hidden" name="locationRowKey" value="">
				<input type="hidden" name="duration" value="">
				<button class="w-100 btn btn-primary" type="submit">Envoyer</button>
			</form>
		</section>
		<section id="feedback-thanks" class="col-lg-7 mx-auto text-center py-5" hidden>
			<h1 class="fw-light mb-3">Merci pour votre avis</h1>
			<p class="lead">Votre commentaire a bien été envoyé.</p>
			<a class="btn btn-outline-primary" href="./">Retour à l'accueil</a>
		</section>
	</main>
{%- endblock %}
