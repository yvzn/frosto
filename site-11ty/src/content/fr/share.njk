						<a class="btn btn-primary"
							href="mailto:?subject=Alerte%20gel%C3%A9es%20gratuite&amp;body=Je%20te%20recommande%20ce%20service%20gratuit%20d%27alerte%20gel%20:%20{{ site.domain }}/">Par
