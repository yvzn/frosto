{% extends "layouts/base.njk" %}

{% block main %}
	<main>
		<section class="container py-5">
			<div class="row justify-content-center py-lg-5">
				<article class="col-lg-8 p-4 p-md-5">
					<h1 class="fw-light">Recommander le service</h1>
					<p class="lead text-muted">Faites connaître les alertes gel gratuites à vos amis, voisins ou collègues.</p>

					<div class="d-flex flex-wrap gap-2 my-4" data-share-url="{{ site.domain }}/">
