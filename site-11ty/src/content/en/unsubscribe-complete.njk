{% extends "layouts/base.njk" %}

{% block main %}
	<main>
		<section class="container py-5">
			<div class="row flex-lg-row-reverse align-items-center py-lg-5">
				<article class="col-8 col-sm-6 col-lg-5 p-4 p-md-5">
					{#- Same alt text as check-subscription-complete (known quirk, see README). #}
					<img src="./asset/undraw_season-change_ohe6.svg" class="d-block mx-lg-auto img-fluid"
