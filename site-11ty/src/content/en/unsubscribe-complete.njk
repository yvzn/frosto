						<a href="./" class="btn btn-outline-success my-2">Return</a>
					</p>
					<p class="text-muted my-4">If you have any questions or need assistance, feel free to <a
							href="./contact.html">contact us</a>.</p>
					<p class="text-muted small">Before you go, <a href="./feedback.html">tell us what you think</a>.</p>
				</article>
			</div>
		</section>
	</main>
{%- endblock %}
