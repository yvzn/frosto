---
title: Sign up for Frost Alerts — Free Frost Alert App
description: Sign up to get free frost alerts near you. Personalized frost alerts for my area, sent only when negative temperatures are forecast.
homeLabel: Home page
script: sign-up
---
{% extends "layouts/base.njk" %}

{#- The consent checkbox differs from the French one (form-check markup): not the shared partial. #}
{% block main %}
	<main>
		<section class="py-5 container">
			<div class="row py-lg-5">
				<article class="col-lg-6 p-4 p-md-5">
					<h1 class="fw-light mb-3">Sign up</h1>
					<p class="lead text-muted col-lg-10">Enter your contact details, you will only be alerted if
						negative temperatures are forecast.</p>
					<p class="lead text-muted col-lg-10">Free service. No other commercial solicitations from us.</p>
				</article>
				<article class="col-md-10 mx-auto col-lg-6">
					<form class="p-4 p-md-5 border rounded-3 bg-light" action="%VITE_SIGNUP_URL%"
						aria-label="Your contact details" method="post" enctype="application/x-www-form-urlencoded">
						<div class="form-floating mb-3">
							<input type="email" class="form-control" id="email" name="email"
								placeholder="first.last@example.com" required="required" autocomplete="email" />
							<label for="email">Email address</label>
						</div>
						<div class="form-floating mb-3">
							<input type="text" class="form-control" id="city" name="city" placeholder="London"
								required="required" autocomplete="address-level2" />
							<label for="city">City</label>
						</div>
						<div class="form-floating mb-3">
							<input type="text" class="form-control" id="zipCode" name="zipCode" placeholder="SW1A 1AA"
								autocomplete="postal-code" />
							<label for="zipCode">Postal code</label>
						</div>
						<div class="form-floating mb-3">
							<input type="text" class="form-control" id="country" name="country"
								placeholder="United Kingdom" required="required" autocomplete="country-name" />
							<label for="country">Country</label>
						</div>
						<fieldset class="mb-3 d-flex">
							<legend class="fs-6 d-inline-block w-auto me-3 mb-0">Temperature unit:</legend>
							<div class="form-check form-check-inline ms-auto me-0">
								<input class="form-check-input" type="radio" name="temperatureUnit"
									id="temperatureUnitC" value="C" checked="checked" />
								<label class="form-check-label" for="temperatureUnitC">Celsius <span aria-hidden="true">(°C)</span></label>
							</div>
							<div class="form-check form-check-inline ms-3 me-0">
								<input class="form-check-input" type="radio" name="temperatureUnit"
									id="temperatureUnitF" value="F" />
								<label class="form-check-label" for="temperatureUnitF">Fahrenheit <span aria-hidden="true">(°F)</span></label>
							</div>
						</fieldset>
						<div class="form-check mb-3">
							<input class="form-check-input" type="checkbox" id="userConsent" name="userConsent"
								value="true" required="required" />
							<label class="form-check-label" for="userConsent">{{ site.consentLabel }}</label>
						</div>
						<input type="hidden" id="lang" name="lang" value="{{ site.lang }}" />
						<button class="w-100 btn btn-lg btn-primary" type="submit" aria-live="polite">Sign up</button>
					</form>
				</article>
			</div>
		</section>
		<section class="py-5 bg-light">
			<div class="container pb-lg-5">
				<p>FrostAlert.net processes the collected data to analyze weather forecasts and send alerts.</p>
				<p>To learn more about the management of your personal data and to exercise your rights, consult
					the <a class="link-dark" href="./legal.html">service terms of use</a>.
				</p>
			</div>
		</section>
	</main>
{%- endblock %}
