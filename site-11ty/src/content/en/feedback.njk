---
title: Your feedback - Frost Alerts
description: Tell us whether an alert was useful or was wrong or unnecessary.
noindex: true
homeLabel: Home
script: feedback
---
{% extends "layouts/base.njk" %}

{% block main %}
	<main>
		<section id="feedback-form-section" class="py-5 container">
			<div class="row py-lg-5">
				<article class="col-lg-6 p-4 p-md-5">
					<h1 class="fw-light mb-3">Give us your feedback</h1>
					<p class="lead text-muted col-lg-10">Your feedback helps us improve the relevance of the service.</p>
					<p class="text-muted col-lg-10"><a href="./share.html">You can also recommend the service to
							friends and neighbours</a>.</p>
				</article>
				<article class="col-md-10 mx-auto col-lg-6">
					<form id="feedback-form" class="p-4 p-md-5 border rounded-3 bg-light" action="%VITE_FEEDBACK_URL%"
						aria-label="Feedback form" method="post" enctype="application/x-www-form-urlencoded">
						<fieldset class="mb-4">
							<legend class="form-label form-text">Are frost alerts useful to you?</legend>
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="radio" name="sentiment" id="sentiment-positive" value="positive" required>
								<label class="form-check-label" for="sentiment-positive">👍 Yes</label>
							</div>
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="radio" name="sentiment" id="sentiment-negative" value="negative" required>
								<label class="form-check-label" for="sentiment-negative">👎 No</label>
							</div>
						</fieldset>
						<div class="form-text mb-3">Do you have any suggestions or comments (optional)?</div>
						<div class="form-floating mb-3">
							<textarea class="form-control" id="text" name="text" maxlength="500" style="height: 120px" placeholder="Your comment"></textarea>
							<label for="text">Free-form comment</label>
						</div>
						<div class="form-text mb-3">May we contact you about this feedback (optional)?</div>
						<div class="form-floating mb-3">
							<input type="email" class="form-control" id="email" name="email" maxlength="254" autocomplete="email" placeholder="name.surname@example.com">
							<label for="email">E-mail address</label>
						</div>
						<div id="feedback-consent" class="form-check mb-3">
							<input class="form-check-input" type="checkbox" id="consent" name="consent" value="true">
							<label class="form-check-label" for="consent">I agree that this address may be used to reply or contact me about this feedback.</label>
						</div>
						<div class="form-aside" inert aria-hidden="true">
							<input type="text" name="comment" tabindex="-1" autocomplete="off">
						</div>
						<input type="hidden" name="lang" value="en">
						<input type="hidden" name="source" value="home">
						<input type="hidden" name="locationPartitionKey" value="">
						<input type="hidden" name="locationRowKey" value="">
						<input type="hidden" name="duration" value="">
						<button class="w-100 btn btn-lg btn-primary" type="submit">Send</button>
					</form>
				</article>
			</div>
		</section>
	</main>
{%- endblock %}
