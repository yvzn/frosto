---
title: Sign-up completed — Frost Alerts
canonical: false
noindex: true
header: simple
homeLabel: Back to home
script: sign-up-complete
---
{% extends "layouts/base.njk" %}

{% block main %}
	<main>
		<section class="container py-5">
			<div class="row flex-lg-row-reverse align-items-center py-lg-5">
				<article class="col-8 col-sm-6 col-lg-5 p-4 p-md-5">
					<img src="./asset/undraw_high_five_re_jy71.svg" class="d-block mx-lg-auto img-fluid"
						alt="An envelope symbolizing registration confirmation" width="600" height="429" />
				</article>
				<article class="col-lg-7 p-4 p-md-5">
					<h1 class="fw-light">Sign-up completed</h1>
					<p class="lead text-muted">To ensure you receive your alerts, please add <span id="ademl">[our
							email address]</span> to your contact list.</p>
					<p>
						<a href="./" class="btn btn-outline-success my-2">Return</a>
					</p>
					<p class="text-muted">We will perform the necessary configuration so that you can receive your
						alerts soon.</p>
					<p class="text-muted my-4">If you need to customize your subscription (temperature threshold,
						altitude, ...) or to cancel your subscription, feel free to <a href="./contact.html">contact
							us</a>.</p>
					<aside class="mt-5">
						<h2 class="h4">Know someone who would like this?</h2>
						<div class="d-flex flex-wrap gap-2 my-3" data-share-url="{{ site.domain }}/">
							<button class="btn btn-success d-none" type="button" data-share-native>Share</button>
							<a class="btn btn-success" href="mailto:?subject=Free%20frost%20alerts&amp;body=I%20recommend%20this%20free%20frost%20alert%20service:%20{{ site.domain }}/">By email</a>
							<button class="btn btn-outline-secondary d-none" type="button" data-share-copy>Copy link</button>
							<span class="align-self-center text-success d-none" role="status" data-share-status>Link copied</span>
						</div>
						<p class="mb-0" data-share-fallback><a href="./share.html">More ways to share</a></p>
					</aside>
				</article>
			</div>
		</section>
	</main>
{%- endblock %}
