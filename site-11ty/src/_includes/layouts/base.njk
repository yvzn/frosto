{#-
  Layout of every page except open-meteo.html (a bare redirect).
  Pages extend it ({% extends "layouts/base.njk" %}) and fill two blocks:
    head  extra head tags, after everything below (Open Graph, Twitter)
    main  everything between the header and the page script, <main> included
  Front matter (defaults in src/content/content.11tydata.js):
    title         full <title> (the site name is not appended: titles vary too much)
    description   optional <meta name="description">
    preloadImage  optional, image preloaded with high priority
    canonical     true: canonical + hreflang links after the description
    noindex       true: <meta name="robots" content="noindex" />
    header        'full' or 'simple'
    homeLabel     aria-label of the link to the home page in the header
    brand         optional, site name shown in the header (default: site.name)
    script        page script, without .js
  The head tags keep the order of the pre-Eleventy pages (zero-diff migration): change it deliberately.
-#}
<!DOCTYPE html>
<html lang="{{ site.lang }}">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{%- if description %}
	<meta name="description" content="{{ description }}" />
{%- endif %}
	<link rel="icon" type="image/svg+xml" href="./asset/favicon.svg" />
{%- if preloadImage %}
	<link rel="preload" fetchpriority="high" as="image" href="{{ preloadImage }}" type="image/svg+xml" />
{%- endif %}
{%- if canonical %}
	<link rel="canonical" href="{{ site.domain }}{{ pagePath }}" />
	<title>{{ title }}</title>
	<link rel="alternate" hreflang="{{ site.lang }}" href="{{ site.domain }}{{ pagePath }}" />
	<link rel="alternate" hreflang="{{ site.alternateLang }}" href="{{ site.alternateDomain }}{{ pagePath }}" />
	{%- if pagePath == '/' %}
	<link rel="alternate" hreflang="x-default" href="{{ site.xDefaultDomain }}/" />
	{%- endif %}
	{%- if noindex %}
	<meta name="robots" content="noindex" />
	{%- endif %}
{%- else %}
	{%- if noindex %}
	<meta name="robots" content="noindex" />
	{%- endif %}
	<title>{{ title }}</title>
{%- endif %}
{%- block head %}{% endblock %}
</head>

<body>
{%- if header == 'simple' %}
	{% include "partials/header-simple.njk" %}
{%- else %}
	{% include "partials/header.njk" %}
{%- endif %}
{%- block main %}{% endblock %}

	<script type="module" src="./{{ script }}.js"></script>
</body>

</html>
